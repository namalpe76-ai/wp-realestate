{
  "id": "11aa-contact-page",
  "title": "11AA Contact Us Page",
  "type": "page",
  "version": "0.4",
  "author": "11AA Real Estate",
  "description": "Contact page with info cards, Google Maps embed, enquiry form, business hours, and social links.",
  "elements": [
    {
      "id": "contact-hero",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "background_background": "classic",
        "background_color": "#1A1A2E",
        "padding": {"unit": "px", "top": "100", "right": "0", "bottom": "100", "left": "0", "isLinked": false},
        "text_align": "center"
      },
      "elements": [
        {
          "id": "contact-hero-subtitle",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Contact Us",
            "header_size": "h6",
            "align": "center",
            "title_color": "#c8a951",
            "typography_typography": "custom",
            "typography_letter_spacing": {"unit": "px", "size": 3, "sizes": []},
            "typography_text_transform": "uppercase"
          }
        },
        {
          "id": "contact-hero-title",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Get In Touch",
            "header_size": "h1",
            "align": "center",
            "title_color": "#FFFFFF",
            "typography_typography": "custom",
            "typography_font_size": {"unit": "px", "size": 48, "sizes": []}
          }
        },
        {
          "id": "contact-hero-desc",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p>We'd love to hear from you. Reach out using any of the methods below, or fill out the enquiry form and we'll get back to you within 24 hours.</p>",
            "text_color": "#CCCCCC",
            "align": "center"
          }
        }
      ]
    },
    {
      "id": "contact-info-section",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": {"unit": "px", "size": 1100, "sizes": []},
        "padding": {"unit": "px", "top": "60", "right": "0", "bottom": "60", "left": "0", "isLinked": false}
      },
      "elements": [
        {
          "id": "contact-info-col-address",
          "elType": "column",
          "settings": {
            "_column_size": 33,
            "padding": {"unit": "px", "top": "15", "right": "15", "bottom": "15", "left": "15", "isLinked": false}
          },
          "elements": [
            {
              "id": "info-address",
              "elType": "widget",
              "widgetType": "icon-box",
              "settings": {
                "selected_icon": {"value": "fas fa-map-marker-alt", "library": "fa-solid"},
                "title": "Visit Us",
                "description": "123 Business Avenue, Suite 100<br>Colombo, Sri Lanka",
                "title_color": "#1A1A2E",
                "description_color": "#666666",
                "align": "center",
                "icon_align": "top",
                "icon_size": {"unit": "px", "size": 36, "sizes": []},
                "icon_color": "#c8a951",
                "content_padding": {"unit": "px", "top": "20", "right": "15", "bottom": "20", "left": "15", "isLinked": false},
                "background_color": "#F7F8FA",
                "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}
              }
            }
          ]
        },
        {
          "id": "contact-info-col-phone",
          "elType": "column",
          "settings": {
            "_column_size": 33,
            "padding": {"unit": "px", "top": "15", "right": "15", "bottom": "15", "left": "15", "isLinked": false}
          },
          "elements": [
            {
              "id": "info-phone",
              "elType": "widget",
              "widgetType": "icon-box",
              "settings": {
                "selected_icon": {"value": "fas fa-phone-alt", "library": "fa-solid"},
                "title": "Call Us",
                "description": "+94 11 234 5678<br>+94 77 123 4567 (WhatsApp)<br>info@11aarealestate.com",
                "title_color": "#1A1A2E",
                "description_color": "#666666",
                "align": "center",
                "icon_align": "top",
                "icon_size": {"unit": "px", "size": 36, "sizes": []},
                "icon_color": "#c8a951",
                "content_padding": {"unit": "px", "top": "20", "right": "15", "bottom": "20", "left": "15", "isLinked": false},
                "background_color": "#F7F8FA",
                "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}
              }
            }
          ]
        },
        {
          "id": "contact-info-col-hours",
          "elType": "column",
          "settings": {
            "_column_size": 33,
            "padding": {"unit": "px", "top": "15", "right": "15", "bottom": "15", "left": "15", "isLinked": false}
          },
          "elements": [
            {
              "id": "info-hours",
              "elType": "widget",
              "widgetType": "icon-box",
              "settings": {
                "selected_icon": {"value": "fas fa-clock", "library": "fa-solid"},
                "title": "Business Hours",
                "description": "Monday - Friday: 9:00 AM - 6:00 PM<br>Saturday: 9:00 AM - 1:00 PM<br>Sunday & Public Holidays: Closed",
                "title_color": "#1A1A2E",
                "description_color": "#666666",
                "align": "center",
                "icon_align": "top",
                "icon_size": {"unit": "px", "size": 36, "sizes": []},
                "icon_color": "#c8a951",
                "content_padding": {"unit": "px", "top": "20", "right": "15", "bottom": "20", "left": "15", "isLinked": false},
                "background_color": "#F7F8FA",
                "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}
              }
            }
          ]
        }
      ]
    },
    {
      "id": "contact-map-form",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": {"unit": "px", "size": 1200, "sizes": []},
        "padding": {"unit": "px", "top": "20", "right": "0", "bottom": "80", "left": "0", "isLinked": false}
      },
      "elements": [
        {
          "id": "map-form-columns",
          "elType": "section",
          "settings": {
            "layout": "boxed",
            "content_width": {"unit": "px", "size": 1200, "sizes": []}
          },
          "elements": [
            {
              "id": "contact-col-map",
              "elType": "column",
              "settings": {
                "_column_size": 50,
                "padding": {"unit": "px", "top": "0", "right": "15", "bottom": "0", "left": "15", "isLinked": false}
              },
              "elements": [
                {
                  "id": "contact-map-title",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "Find Us on the Map",
                    "header_size": "h4",
                    "title_color": "#1A1A2E"
                  }
                },
                {
                  "id": "contact-map",
                  "elType": "widget",
                  "widgetType": "google_maps",
                  "settings": {
                    "address": "123 Business Avenue, Colombo, Sri Lanka",
                    "zoom": {"unit": "px", "size": 15, "sizes": []},
                    "height": {"unit": "px", "size": 450, "sizes": []},
                    "border_border": "solid",
                    "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true},
                    "border_color": "#E8E8E8",
                    "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}
                  }
                },
                {
                  "id": "contact-hours-title",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "Office Hours",
                    "header_size": "h5",
                    "title_color": "#1A1A2E",
                    "_margin": {"unit": "px", "top": "25", "right": "0", "bottom": "5", "left": "0", "isLinked": false}
                  }
                },
                {
                  "id": "contact-hours-list",
                  "elType": "widget",
                  "widgetType": "icon-list",
                  "settings": {
                    "icon_list": [
                      {"text": "Monday - Friday: 9:00 AM - 6:00 PM", "selected_icon": {"value": "fas fa-clock", "library": "fa-solid"}},
                      {"text": "Saturday: 9:00 AM - 1:00 PM", "selected_icon": {"value": "fas fa-clock", "library": "fa-solid"}},
                      {"text": "Sunday & Public Holidays: Closed", "selected_icon": {"value": "fas fa-times-circle", "library": "fa-solid"}}
                    ],
                    "text_color": "#444444",
                    "icon_color": "#c8a951"
                  }
                }
              ]
            },
            {
              "id": "contact-col-form",
              "elType": "column",
              "settings": {
                "_column_size": 50,
                "padding": {"unit": "px", "top": "0", "right": "15", "bottom": "0", "left": "15", "isLinked": false}
              },
              "elements": [
                {
                  "id": "contact-form-title",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "Send Us a Message",
                    "header_size": "h4",
                    "title_color": "#1A1A2E"
                  }
                },
                {
                  "id": "contact-form-shortcode",
                  "elType": "widget",
                  "widgetType": "shortcode",
                  "settings": {
                    "shortcode": "[property_enquiry_form]"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "contact-social",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": {"unit": "px", "size": 800, "sizes": []},
        "background_background": "classic",
        "background_color": "#F7F8FA",
        "padding": {"unit": "px", "top": "60", "right": "0", "bottom": "60", "left": "0", "isLinked": false},
        "text_align": "center"
      },
      "elements": [
        {
          "id": "social-title",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Follow Us",
            "header_size": "h3",
            "align": "center",
            "title_color": "#1A1A2E"
          }
        },
        {
          "id": "social-icons",
          "elType": "widget",
          "widgetType": "icon-list",
          "settings": {
            "icon_list": [
              {"text": "Facebook", "selected_icon": {"value": "fab fa-facebook-f", "library": "fa-brands"}},
              {"text": "Twitter / X", "selected_icon": {"value": "fab fa-twitter", "library": "fa-brands"}},
              {"text": "Instagram", "selected_icon": {"value": "fab fa-instagram", "library": "fa-brands"}},
              {"text": "LinkedIn", "selected_icon": {"value": "fab fa-linkedin-in", "library": "fa-brands"}},
              {"text": "WhatsApp: +94 77 123 4567", "selected_icon": {"value": "fab fa-whatsapp", "library": "fa-brands"}}
            ],
            "text_color": "#444444",
            "icon_color": "#c8a951",
            "icon_align": "left",
            "align": "center",
            "typography_typography": "custom",
            "typography_font_size": {"unit": "px", "size": 17, "sizes": []}
          }
        }
      ]
    }
  ]
}
