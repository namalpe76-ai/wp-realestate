          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p>11AA Real Estate has established itself as a trusted name in property sales, rentals, and management across Sri Lanka. Our team of dedicated professionals is committed to helping you find the perfect property that matches your lifestyle and investment goals.</p><p>We combine deep local market knowledge with modern technology to deliver a seamless real estate experience. Whether you're buying your first home, selling a commercial property, or building an investment portfolio — we're here to help every step of the way.</p>",
            "text_color": "#444444",
            "align": "center",
            "typography_typography": "custom",
            "typography_font_size": {"unit": "px", "size": 17, "sizes": []}
          }
        }
      ]
    },
